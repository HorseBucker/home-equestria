# Godot
.godot/
/android/
export_presets.cfg
*.translation

# Build output
/build/
/dist/

# Converted zone assets: large, rebuilt locally.
/world/zones/**/*.glb
/world/zones/**/*.gltf
/world/zones/**/*.bin
/world/zones/**/*.png
/world/zones/**/*.jpg
/world/zones/**/*.res
/world/zones/**/*.scn
# Import sidecars are regenerated for assets that are themselves ignored.
/world/zones/**/*.import
# Heightmaps (4-17 MB each), rebuilt locally.
/world/zones/**/*.f32
# Terrain3D region data and generator tiles: rebuilt from world_layout.json + overrides.
/world/terrain/data/
/world/terrain/gen/
/world/terrain/gen_mesh_fit/
/world/biomes/generated/
/world/foliage/assets/
/world/foliage/grassy_fields/

# Python environment for the asset tools.
/.venv/

# Harness output
/captures/
/logs/
*.log

# Python bytecode
__pycache__/

# Sound work files; converted clips live beside them.
/world/audio/src/

# Local-only character exports.
/world/characters/openpony/*.glb
/world/characters/openpony/*.glb.import
/world/characters/openpony/lashes.png
/world/characters/openpony/lashes.png.import
/world/characters/openpony/lashes_cached.png
/world/characters/openpony/lashes_cached.png.import
/world/characters/openpony/deform_bones.txt

# Local-only character derivatives.
/world/characters/hybrid_mare/*.glb
/world/characters/hybrid_mare/*.glb.import
/world/characters/hybrid_mare/neck_build.json
# Local AI settings.
/ai_config.json
/world/zones/**/*.baked.json
/world/zones/**/*.baked.d/
/world/zones/**/*.proxy.scn
/world/zones/**/*.proxy.json

# Local-only animation data.
/world/characters/hybrid_mare/postures.res
/world/characters/hybrid_mare/pony_flight.json

# Local-only background pony art.
/world/characters/background/*.glb
/world/characters/background/*.glb.import
/world/characters/background/*.scn
/world/characters/background/*.blend
/world/characters/background/*.png*
/world/characters/background/*.svg*
/world/characters/background/marks/
/world/characters/background/support/
/world/characters/background/accessories/*.glb*
/world/characters/background/accessories/*.scn

# Local-only map atlas, rebuilt locally.
/world/ui/pony_map_icons.png*

# Local generated terrain study.
/tools/gaea_study/generated/
/world/terrain/gaea/

# Local-only geometry.
/world/characters/hybrid_mare/openpony_dock.res

# Local-only Anon preview and masks.
/world/customization/anon_preview.tscn
/world/customization/clothing_mask.png*

# Local-only props and chatter audio.
/world/inventory/assets/source/*.glb
/world/audio/chatter/banks/

/world/inventory/assets/source/*.scn

# Local-only head collider.
/world/characters/hybrid_mare/skull_contact.tres

# Local railway bakes.
world/railway/*.scn
world/railway/*.res
world/zones/cantermore/corridor_proxy/

# Local-only princess models.
/world/characters/princesses/*.glb*
/world/characters/princesses/*.png*
/world/characters/princesses/*.blend*
/builds/

# Local-only timberwolf model.
/world/characters/timberwolf/*.glb
/world/characters/timberwolf/*.glb.import
/world/characters/timberwolf/*.scn

# Local-only ambience sounds.
/world/audio/everfree/*.ogg
/world/audio/everfree/*.ogg.import

# Native build intermediates.
/native/pony_solver/src/*.os
/native/pony_solver/.sconsign.dblite
# Baked gait clips, rebuilt locally.
/world/characters/baked_gaits/

# Release archives and model work files.
/RELEASE/
/art/
# Downloaded speech model.
/world/ai/whisper/*.bin
# Personal editor settings.
/.claude/settings.local.json
